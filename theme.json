{
  "name": "SAO",
  "short": "sao",
  "description": "SAO系列探针主题的 Monitor 版本",
  "version": "1.3.1",
  "author": "WAOR",
  "url": "https://github.com/WAOR/Monitor-SAO",
  "config": [
    {
      "type": "title",
      "label": "外观布局"
    },
    {
      "key": "defaultAppearance",
      "type": "select",
      "label": "色彩模式",
      "help": "设置深色、浅色或跟随系统外观",
      "default": "dark",
      "options": [
        {
          "value": "system",
          "label": "跟随系统"
        },
        {
          "value": "dark",
          "label": "深色护眼"
        },
        {
          "value": "light",
          "label": "浅色明亮"
        }
      ]
    },
    {
      "key": "desktopNodeViewMode",
      "type": "select",
      "label": "桌面视图",
      "help": "电脑端服务器卡片的默认展示样式",
      "default": "large",
      "options": [
        {
          "value": "large",
          "label": "标准网格"
        },
        {
          "value": "compact",
          "label": "紧凑网格"
        },
        {
          "value": "mini",
          "label": "极简胶囊"
        },
        {
          "value": "list",
          "label": "清单列表"
        }
      ]
    },
    {
      "key": "mobileNodeViewMode",
      "type": "select",
      "label": "移动视图",
      "help": "手机端服务器卡片的默认展示样式",
      "default": "compact",
      "options": [
        {
          "value": "compact",
          "label": "紧凑网格"
        },
        {
          "value": "large",
          "label": "标准网格"
        },
        {
          "value": "mini",
          "label": "极简胶囊"
        }
      ]
    },
    {
      "key": "clusterOverviewMode",
      "type": "select",
      "label": "展台模式",
      "help": "选择经典双曲线或机架方格热力矩阵",
      "default": "classic",
      "options": [
        {
          "value": "classic",
          "label": "经典双层 (状态与流量)"
        },
        {
          "value": "nodes",
          "label": "方格矩阵 (机架全景)"
        }
      ]
    },
    {
      "key": "matrixColorTheme",
      "type": "select",
      "label": "配色风格",
      "help": "展台与核心卡片的主题色彩风格",
      "default": "eva",
      "options": [
        {
          "value": "default",
          "label": "经典监控 (绿·橙·红)"
        },
        {
          "value": "eva",
          "label": "初号机 (紫·绿·橙)"
        },
        {
          "value": "divergence",
          "label": "命运石 (暖杏橙)"
        }
      ]
    },
    {
      "key": "matrixBootAnimation",
      "type": "boolean",
      "label": "开场动画",
      "help": "进入首页时播放方格光束横扫动效",
      "default": true
    },
    {
      "key": "matrixBootEffect",
      "type": "select",
      "label": "动效样式",
      "help": "设置进入首页时的开场显影流光",
      "default": "laser-scan",
      "options": [
        {
          "value": "laser-scan",
          "label": "激光横扫"
        },
        {
          "value": "digital-rain",
          "label": "数码雨流"
        },
        {
          "value": "cyber-glitch",
          "label": "神经故障"
        },
        {
          "value": "divergence-flux",
          "label": "世界线跳变"
        }
      ]
    },
    {
      "key": "matrixMockFill",
      "type": "boolean",
      "label": "虚位填满",
      "help": "用动态模拟数据补齐未接入的空机位",
      "default": false
    },
    {
      "key": "showGroupTabs",
      "type": "boolean",
      "label": "分组筛选",
      "help": "在卡片上方显示分组快捷切换标签",
      "default": true
    },
    {
      "key": "showUngroupedTab",
      "type": "boolean",
      "label": "未分组项",
      "help": "在分组栏单独展示未分类的服务器",
      "default": false
    },
    {
      "key": "showRegionBar",
      "type": "boolean",
      "label": "地区筛选",
      "help": "在卡片上方展示国旗地区快捷标签",
      "default": true
    },
    {
      "key": "showCardGroup",
      "type": "boolean",
      "label": "卡片分组",
      "help": "在服务器卡片副标题标注所属分组",
      "default": true
    },
    {
      "key": "enableHomeSort",
      "type": "boolean",
      "label": "访客排序",
      "help": "允许访客在首页下拉自主切换排序",
      "default": true
    },
    {
      "key": "homeSortField",
      "type": "select",
      "label": "排序指标",
      "help": "首页未手动排序时的默认排列依据",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "默认权重"
        },
        {
          "value": "name",
          "label": "节点名称"
        },
        {
          "value": "speed",
          "label": "实时网速"
        },
        {
          "value": "traffic",
          "label": "今日流量"
        },
        {
          "value": "price",
          "label": "续费价格"
        }
      ]
    },
    {
      "key": "homeSortDirection",
      "type": "select",
      "label": "排序方向",
      "help": "设定默认由小到大或由大到小排布",
      "default": "asc",
      "options": [
        {
          "value": "asc",
          "label": "升序排列"
        },
        {
          "value": "desc",
          "label": "降序排列"
        }
      ]
    },
    {
      "key": "hiddenNodes",
      "type": "string",
      "label": "隐藏节点",
      "help": "首页不显示的机器名称，逗号隔开",
      "default": ""
    },
    {
      "type": "title",
      "label": "监控组件"
    },
    {
      "key": "showHomeOverview",
      "type": "boolean",
      "label": "监控总览",
      "help": "在首页顶部展示核心数据与资产卡片",
      "default": true
    },
    {
      "key": "overviewFollowGroup",
      "type": "boolean",
      "label": "分组联动",
      "help": "切换分组时总览卡片仅统计当前分组",
      "default": false
    },
    {
      "key": "showTrafficPageButton",
      "type": "boolean",
      "label": "流量入口",
      "help": "在今日流量卡片显示进入详情页按钮",
      "default": true
    },
    {
      "key": "showTrafficPageForGuests",
      "type": "boolean",
      "label": "访客流量",
      "help": "允许未登录访客点击查看详细流量页",
      "default": false
    },
    {
      "key": "showCostSummary",
      "type": "boolean",
      "label": "资产入口",
      "help": "在资产总值卡片显示进入统计页按钮",
      "default": true
    },
    {
      "key": "showCostSummaryFloatingButton",
      "type": "boolean",
      "label": "悬浮资产",
      "help": "未开资产卡片时在右下角悬浮显示入口",
      "default": true
    },
    {
      "key": "showPriceForGuests",
      "type": "boolean",
      "label": "公开资产",
      "help": "允许访客查看机器价格与资产总金额",
      "default": false
    },
    {
      "key": "enableHomepageMultiPing",
      "type": "boolean",
      "label": "多线延迟",
      "help": "在卡片上直接呈现多线路延迟连通光柱",
      "default": false
    },
    {
      "key": "fakePingForUnbound",
      "type": "boolean",
      "label": "平滑占位",
      "help": "无探测数据时显示平滑占位保持工整",
      "default": false
    },
    {
      "key": "showTodayTrafficPopover",
      "type": "boolean",
      "label": "当日峰值",
      "help": "在卡片网络区显示当日出入与峰值按键",
      "default": true
    },
    {
      "key": "showConnections",
      "type": "boolean",
      "label": "连接数量",
      "help": "在卡片网络区标注实时网络活跃连接数",
      "default": false
    },
    {
      "key": "compactShowTrafficTotal",
      "type": "boolean",
      "label": "累计流量",
      "help": "在紧凑卡片中展示月度或累计出入总计",
      "default": true
    },
    {
      "key": "compactShowBilling",
      "type": "boolean",
      "label": "计费周期",
      "help": "在紧凑卡片中保留续费周期时间标注",
      "default": true
    },
    {
      "key": "compactShowUptime",
      "type": "boolean",
      "label": "在线时长",
      "help": "在紧凑卡片中展示服务器连续开机时间",
      "default": true
    },
    {
      "type": "title",
      "label": "资产财务"
    },
    {
      "key": "costRateApiUrl",
      "type": "string",
      "label": "汇率接口",
      "help": "外币汇率接口，留空使用官方默认",
      "default": "https://open.er-api.com/v6/latest/CNY"
    },
    {
      "key": "costIgnoredNodes",
      "type": "string",
      "label": "排除机器",
      "help": "不计入资产的机器名称，逗号隔开",
      "default": ""
    },
    {
      "type": "title",
      "label": "文字评级"
    },
    {
      "key": "showTrafficRating",
      "type": "boolean",
      "label": "流量评级",
      "help": "在今日流量小卡底部显示用量评价标签",
      "default": false
    },
    {
      "key": "trafficRatingLabels",
      "type": "string",
      "label": "流量词库",
      "help": "从低到高填入4个评价词，以逗号隔开",
      "default": ""
    },
    {
      "key": "showAssetRating",
      "type": "boolean",
      "label": "资产评级",
      "help": "在资产总值小卡底部显示总值评价标签",
      "default": false
    },
    {
      "key": "assetRatingLabels",
      "type": "string",
      "label": "资产词库",
      "help": "从低到高填入4个评价词，以逗号隔开",
      "default": ""
    },
    {
      "key": "showBandwidthRating",
      "type": "boolean",
      "label": "带宽评级",
      "help": "在集群展台顶部显示实时带宽状态徽章",
      "default": true
    },
    {
      "key": "bandwidthRatingLabels",
      "type": "string",
      "label": "带宽词库",
      "help": "从低到高填入4个评价词，以逗号隔开",
      "default": ""
    },
    {
      "type": "title",
      "label": "管理安全"
    },
    {
      "key": "enableAdminButton",
      "type": "boolean",
      "label": "登录入口",
      "help": "在首页右上角显示管理员登录管理按键",
      "default": true
    },
    {
      "key": "adminNickname",
      "type": "string",
      "label": "管理昵称",
      "help": "登录后在顶部问候语处展示的昵称",
      "default": ""
    }
  ]
}
