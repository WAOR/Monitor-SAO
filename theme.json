{
  "name": "SAO",
  "short": "sao",
  "description": "极简立体仪表盘主题 · 适配 Monitor 探针 (v1.3.2+)",
  "version": "1.1.0",
  "author": "WAOR",
  "url": "https://github.com/WAOR/Monitor-SAO",
  "config": [
    {
      "type": "title",
      "label": "外观与布局"
    },
    {
      "key": "defaultAppearance",
      "type": "select",
      "label": "默认色彩模式",
      "default": "system",
      "options": [
        {
          "value": "system",
          "label": "跟随系统"
        },
        {
          "value": "dark",
          "label": "深色护眼"
        },
        {
          "value": "light",
          "label": "浅色明亮"
        }
      ]
    },
    {
      "key": "desktopNodeViewMode",
      "type": "select",
      "label": "桌面端默认卡片视图",
      "default": "large",
      "options": [
        {
          "value": "large",
          "label": "标准网格 (Large)"
        },
        {
          "value": "compact",
          "label": "紧凑网格 (Compact)"
        },
        {
          "value": "mini",
          "label": "极简胶囊 (Mini)"
        },
        {
          "value": "list",
          "label": "清单列表 (List)"
        }
      ]
    },
    {
      "key": "mobileNodeViewMode",
      "type": "select",
      "label": "移动端默认卡片视图",
      "default": "compact",
      "options": [
        {
          "value": "compact",
          "label": "紧凑网格 (Compact)"
        },
        {
          "value": "large",
          "label": "标准网格 (Large)"
        },
        {
          "value": "mini",
          "label": "极简胶囊 (Mini)"
        },
        {
          "value": "list",
          "label": "清单列表 (List)"
        }
      ]
    },
    {
      "key": "clusterOverviewMode",
      "type": "select",
      "label": "首页集群状态展示模式",
      "default": "classic",
      "options": [
        {
          "value": "classic",
          "label": "经典双层卡片 (上下两层：状态与实时流量)"
        },
        {
          "value": "nodes",
          "label": "机架方格热力矩阵 (20 列紧凑机架网格全景)"
        }
      ]
    },
    {
      "key": "matrixColorTheme",
      "type": "select",
      "label": "机架方格矩阵配色风格",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "经典标准 (绿 · 橙 · 红)"
        },
        {
          "value": "eva",
          "label": "EVA 初号机 (紫 · 荧光绿 · 橙红)"
        }
      ]
    },
    {
      "key": "matrixBootAnimation",
      "type": "boolean",
      "label": "方格矩阵 SAO 主题开场动画",
      "help": "进入首页时方格矩阵是否播放光束横扫与开场点阵动画",
      "default": true
    },
    {
      "key": "matrixMockFill",
      "type": "boolean",
      "label": "模拟数据填充机架空闲机位插槽",
      "help": "在方格矩阵中是否使用动态模拟负载数据填满未接入服务器的闲置插槽",
      "default": false
    },
    {
      "key": "showGroupTabs",
      "type": "boolean",
      "label": "显示分组筛选栏",
      "help": "在卡片列表上方展示分组 Tab 快速筛选",
      "default": true
    },
    {
      "key": "showUngroupedTab",
      "type": "boolean",
      "label": "在分组栏显示“未分组”标签",
      "help": "当存在未指定分组的节点时，在分组栏提供“未分组”快捷标签（关闭后未分组节点仍在“全部”中可见）",
      "default": false
    },
    {
      "key": "showRegionBar",
      "type": "boolean",
      "label": "显示地区筛选栏",
      "help": "在卡片列表上方展示国旗地区快捷标签",
      "default": true
    },
    {
      "key": "showCardGroup",
      "type": "boolean",
      "label": "在卡片上显示节点分组标签",
      "help": "在卡片副标题处标明其所属分组",
      "default": true
    },
    {
      "key": "enableHomeSort",
      "type": "boolean",
      "label": "允许前台切换节点排序",
      "help": "在首页卡片上方提供按名称、延迟、流量等排序下拉菜单",
      "default": true
    },
    {
      "type": "title",
      "label": "监控与组件"
    },
    {
      "key": "showHomeOverview",
      "type": "boolean",
      "label": "显示首页顶部总览栏",
      "help": "在首页顶部展示服务器数、在线率、内存、硬盘、流量及资产卡片",
      "default": true
    },
    {
      "key": "overviewFollowGroup",
      "type": "boolean",
      "label": "顶部总览跟随当前分组联动",
      "help": "开启后切换分组时，顶部总览仅统计当前分组数据；关闭后始终统计全站整体数据",
      "default": false
    },
    {
      "key": "enableHomepageMultiPing",
      "type": "boolean",
      "label": "首页展示多线路 Ping 矩阵",
      "help": "在节点卡片上直接呈现多个探测点的实时连通性网格",
      "default": false
    },
    {
      "key": "showTodayTrafficPopover",
      "type": "boolean",
      "label": "显示当日流量与峰值按钮",
      "help": "在节点卡片上显示扩展统计按钮，点击或悬停可查看当日出入站流量与峰值带宽",
      "default": true
    },
    {
      "key": "showConnections",
      "type": "boolean",
      "label": "显示 TCP/UDP 连接数",
      "help": "在卡片网络区域标注实时活跃连接统计",
      "default": false
    },
    {
      "key": "compactShowTrafficTotal",
      "type": "boolean",
      "label": "小卡片显示累计流量",
      "help": "在紧凑视图中展示月度或累计出入站流量",
      "default": true
    },
    {
      "key": "compactShowBilling",
      "type": "boolean",
      "label": "小卡片显示计费周期",
      "help": "在紧凑视图中保留周期标注",
      "default": true
    },
    {
      "key": "compactShowUptime",
      "type": "boolean",
      "label": "小卡片显示在线时长",
      "help": "在紧凑视图中展示系统运行时间",
      "default": true
    },
    {
      "type": "title",
      "label": "资产与财务"
    },
    {
      "key": "showCostSummary",
      "type": "boolean",
      "label": "显示资产统计页入口按钮",
      "help": "在首页资产概览卡右上角显示进入资产统计页的钱币图标按钮",
      "default": true
    },
    {
      "key": "showCostSummaryFloatingButton",
      "type": "boolean",
      "label": "显示资产看板悬浮按钮",
      "help": "卡片入口关闭或无资产卡片时，在右下角提供可拖动的快捷悬浮入口",
      "default": true
    },
    {
      "key": "showPriceForGuests",
      "type": "boolean",
      "label": "向访客公开价格与资产",
      "help": "开启后访客可见价格标签；关闭后对访客隐藏价格并将资产显示为保密",
      "default": false
    },
    {
      "key": "costRateApiUrl",
      "type": "string",
      "label": "实时汇率 API 接口 URL",
      "default": "https://open.er-api.com/v6/latest/CNY",
      "help": "留空使用官方默认免费公共汇率接口"
    },
    {
      "type": "title",
      "label": "文字评级配置"
    },
    {
      "key": "showTrafficRating",
      "type": "boolean",
      "label": "显示今日流量评级",
      "help": "在首页今日流量卡片底部显示用量评级标签",
      "default": true
    },
    {
      "key": "trafficRatingLabels",
      "type": "string",
      "label": "今日流量评级用词",
      "default": "",
      "help": "4 级评级用词以逗号隔开"
    },
    {
      "key": "showAssetRating",
      "type": "boolean",
      "label": "显示资产总值评级",
      "help": "在资产总值卡片底部显示总价值评级标签",
      "default": true
    },
    {
      "key": "assetRatingLabels",
      "type": "string",
      "label": "资产总值评级用词",
      "default": "",
      "help": "4 级评级用词以逗号隔开"
    },
    {
      "key": "showBandwidthRating",
      "type": "boolean",
      "label": "显示集群实时带宽评级",
      "help": "在集群状态中显示实时吞吐评级徽章",
      "default": true
    },
    {
      "key": "bandwidthRatingLabels",
      "type": "string",
      "label": "集群实时带宽评级用词",
      "default": "",
      "help": "4 级评级用词以逗号隔开"
    },
    {
      "type": "title",
      "label": "管理与安全"
    },
    {
      "key": "enableAdminButton",
      "type": "boolean",
      "label": "显示前台管理员登录入口",
      "help": "在页面右上角展示登录/管理面板快捷入口",
      "default": true
    },
    {
      "key": "adminNickname",
      "type": "string",
      "label": "管理员显示昵称",
      "default": "",
      "help": "登录后在页面顶部总览问候语处展示（如：早上好，jerry），留空默认为 Admin"
    },
    {
      "key": "notice",
      "type": "text",
      "label": "全站置顶横幅公告",
      "default": "",
      "help": "显示在首页顶部，支持多行文本，留空则不显示"
    }
  ]
}