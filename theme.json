{
  "name": "SAO",
  "short": "sao",
  "description": "极简立体仪表盘主题 · 适配 Monitor 探针，支持四种布局、流速图表、资产统计与动态背景",
  "version": "1.0.19",
  "author": "jerry",
  "url": "https://github.com/WAOR/Monitor-SAO",
  "config": [
    { "type": "title", "label": "外观与布局" },
    {
      "key": "defaultAppearance",
      "type": "select",
      "label": "默认色彩模式",
      "default": "system",
      "options": [
        { "value": "system", "label": "跟随系统" },
        { "value": "dark", "label": "深色护眼" },
        { "value": "light", "label": "浅色明亮" }
      ]
    },
    {
      "key": "desktopNodeViewMode",
      "type": "select",
      "label": "桌面端默认卡片视图",
      "default": "large",
      "options": [
        { "value": "large", "label": "标准网格 (Large)" },
        { "value": "compact", "label": "紧凑网格 (Compact)" },
        { "value": "mini", "label": "极简胶囊 (Mini)" },
        { "value": "list", "label": "清单列表 (List)" }
      ]
    },
    {
      "key": "mobileNodeViewMode",
      "type": "select",
      "label": "移动端默认卡片视图",
      "default": "compact",
      "options": [
        { "value": "compact", "label": "紧凑网格 (Compact)" },
        { "value": "large", "label": "标准网格 (Large)" },
        { "value": "mini", "label": "极简胶囊 (Mini)" },
        { "value": "list", "label": "清单列表 (List)" }
      ]
    },
    {
      "key": "showGroupTabs",
      "type": "boolean",
      "label": "显示分组筛选栏",
      "help": "在卡片列表上方展示分组 Tab 快速筛选",
      "default": true
    },
    {
      "key": "showRegionBar",
      "type": "boolean",
      "label": "显示地区筛选栏",
      "help": "在卡片列表上方展示国旗地区快捷标签",
      "default": true
    },
    {
      "key": "showCardGroup",
      "type": "boolean",
      "label": "在卡片上显示节点分组标签",
      "help": "在卡片副标题处标明其所属分组",
      "default": true
    },
    {
      "key": "enableHomeSort",
      "type": "boolean",
      "label": "允许前台切换节点排序",
      "help": "在首页卡片上方提供按名称、延迟、流量等排序下拉菜单",
      "default": true
    },

    { "type": "title", "label": "监控与组件" },
    {
      "key": "showHomeOverview",
      "type": "boolean",
      "label": "显示首页顶部总览栏",
      "help": "在首页顶部展示服务器数、在线率、内存、硬盘、流量及资产卡片",
      "default": true
    },

    {
      "key": "enableHomepageMultiPing",
      "type": "boolean",
      "label": "首页展示多线路 Ping 矩阵",
      "help": "在节点卡片上直接呈现多个探测点的实时连通性网格",
      "default": false
    },
    {
      "key": "showTodayTrafficPopover",
      "type": "boolean",
      "label": "显示当日流量与峰值按钮",
      "help": "在节点卡片上显示扩展统计按钮，点击或悬停可查看当日出入站流量与峰值带宽",
      "default": true
    },
    {
      "key": "showConnections",
      "type": "boolean",
      "label": "显示 TCP/UDP 连接数",
      "help": "在卡片网络区域标注实时活跃连接统计",
      "default": false
    },
    {
      "key": "compactShowTrafficTotal",
      "type": "boolean",
      "label": "小卡片显示累计流量",
      "help": "在紧凑视图中展示月度或累计出入站流量",
      "default": true
    },
    {
      "key": "compactShowBilling",
      "type": "boolean",
      "label": "小卡片显示计费周期",
      "help": "在紧凑视图中保留周期标注",
      "default": true
    },
    {
      "key": "compactShowUptime",
      "type": "boolean",
      "label": "小卡片显示在线时长",
      "help": "在紧凑视图中展示系统运行时间",
      "default": true
    },

    { "type": "title", "label": "背景与多媒体" },
    {
      "key": "enableBackgroundImage",
      "type": "boolean",
      "label": "启用自定义背景媒体",
      "help": "开启后将覆盖站点默认背景，优先应用下方配置的壁纸或视频",
      "default": true
    },
    {
      "key": "backgroundMediaType",
      "type": "select",
      "label": "背景媒体形式",
      "default": "image",
      "options": [
        { "value": "image", "label": "静态壁纸图片" },
        { "value": "video", "label": "动态视频背景" }
      ]
    },
    {
      "key": "backgroundImage",
      "type": "string",
      "label": "桌面端背景图 URL",
      "default": "",
      "help": "宽屏与桌面端加载的背景图，支持静态图片或 GIF"
    },
    {
      "key": "backgroundImageMobile",
      "type": "string",
      "label": "移动端背景图 URL",
      "default": "",
      "help": "竖屏手机加载，留空则沿用桌面端背景"
    },
    {
      "key": "backgroundVideo",
      "type": "string",
      "label": "浅色模式视频 URL (MP4)",
      "default": "https://assets.waor.cc/videos/sao_bg.mp4",
      "help": "留空使用 SAO 默认主题动态视频"
    },
    {
      "key": "backgroundVideoDark",
      "type": "string",
      "label": "深色模式视频 URL (MP4)",
      "default": "",
      "help": "留空则在深色下自动叠加暗场滤镜"
    },
    {
      "key": "surfaceOpacity",
      "type": "number",
      "label": "卡片表面不透明度 (0–1)",
      "default": 0.85,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "help": "取值 0 到 1（对应 0% 到 100%），数值越低卡片越通透"
    },

    { "type": "title", "label": "资产与财务" },
    {
      "key": "showCostSummary",
      "type": "boolean",
      "label": "显示资产统计页入口按钮",
      "help": "在首页资产概览卡右上角显示进入资产统计页的钱币图标按钮",
      "default": true
    },
    {
      "key": "showCostSummaryFloatingButton",
      "type": "boolean",
      "label": "显示资产看板悬浮按钮",
      "help": "卡片入口关闭或无资产卡片时，在右下角提供可拖动的快捷悬浮入口",
      "default": true
    },
    {
      "key": "showPriceForGuests",
      "type": "boolean",
      "label": "向访客公开价格与资产",
      "help": "开启后访客可见价格标签；关闭后对访客隐藏价格并将资产显示为保密",
      "default": false
    },
    {
      "key": "costRateApiUrl",
      "type": "string",
      "label": "实时汇率 API 接口 URL",
      "default": "https://open.er-api.com/v6/latest/CNY",
      "help": "留空使用官方默认免费公共汇率接口"
    },

    { "type": "title", "label": "文字评级配置" },
    {
      "key": "showTrafficRating",
      "type": "boolean",
      "label": "显示今日流量评级",
      "help": "在首页今日流量卡片底部显示用量评级标签",
      "default": true
    },
    {
      "key": "trafficRatingLabels",
      "type": "string",
      "label": "今日流量评级用词",
      "default": "",
      "help": "4 级评级用词以逗号隔开"
    },
    {
      "key": "showAssetRating",
      "type": "boolean",
      "label": "显示资产总值评级",
      "help": "在资产总值卡片底部显示总价值评级标签",
      "default": true
    },
    {
      "key": "assetRatingLabels",
      "type": "string",
      "label": "资产总值评级用词",
      "default": "",
      "help": "4 级评级用词以逗号隔开"
    },
    {
      "key": "showBandwidthRating",
      "type": "boolean",
      "label": "显示集群实时带宽评级",
      "help": "在集群状态中显示实时吞吐评级徽章",
      "default": true
    },
    {
      "key": "bandwidthRatingLabels",
      "type": "string",
      "label": "集群实时带宽评级用词",
      "default": "",
      "help": "4 级评级用词以逗号隔开"
    },

    { "type": "title", "label": "管理与安全" },
    {
      "key": "enableAdminButton",
      "type": "boolean",
      "label": "显示前台管理员登录入口",
      "help": "在页面右上角展示登录/管理面板快捷入口",
      "default": true
    },
    {
      "key": "adminNickname",
      "type": "string",
      "label": "管理员显示昵称",
      "default": "",
      "help": "登录后在页面顶部总览问候语处展示（如：早上好，jerry），留空默认为 Admin"
    },
    {
      "key": "notice",
      "type": "text",
      "label": "全站置顶横幅公告",
      "default": "",
      "help": "显示在首页顶部，支持多行文本，留空则不显示"
    }
  ]
}
